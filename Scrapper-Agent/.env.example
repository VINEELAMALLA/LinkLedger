PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Scheduler (runs every 4 hours)
DEADLINE_CRON=0 */4 * * *

# Optional: use a local Chrome executable path if Puppeteer fails to auto-detect
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# SMTP Configuration (for deadline reminder emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_SECURE=false
MAIL_FROM=Deadline Guard <your-email@gmail.com>
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
MAIL_FROM=Deadline Guard <your_email@example.com>
